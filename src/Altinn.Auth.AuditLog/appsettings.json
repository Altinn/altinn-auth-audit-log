{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "Npgsql": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PartitionCleanup": {
    "EnableOldPartitionDeletion": false,
    "RetentionMonths": 2
  },
  "QueueConsumer": {
    "Enabled": false,
    "ConnectionString": null,
    "ServiceUri": null,
    "HealthStaleAfter": "00:05:00",
    "DepthSampleInterval": "00:00:30",
    "Authorization": {
      "Enabled": true,
      "QueueName": "authorizationeventlog",
      "BatchSize": 32,
      "VisibilityTimeout": "00:05:00",
      "MaxDequeueCount": 5,
      "EmptyQueueBackoff": "00:00:01",
      "EmptyQueueMaxBackoff": "00:00:30",
      "ReceiveFailureBackoff": "00:00:02",
      "ReceiveFailureMaxBackoff": "00:01:00",
      "TransientRetryAttempts": 3,
      "TransientRetryBaseDelay": "00:00:01",
      "CircuitBreakFailuresBeforeOpen": 5,
      "CircuitBreakOpenDuration": "00:00:30",
      "ShutdownGracePeriod": "00:00:25"
    },
    "Authentication": {
      "Enabled": true,
      "QueueName": "eventlog",
      "BatchSize": 32,
      "VisibilityTimeout": "00:05:00",
      "MaxDequeueCount": 5,
      "EmptyQueueBackoff": "00:00:01",
      "EmptyQueueMaxBackoff": "00:00:30",
      "ReceiveFailureBackoff": "00:00:02",
      "ReceiveFailureMaxBackoff": "00:01:00",
      "TransientRetryAttempts": 3,
      "TransientRetryBaseDelay": "00:00:01",
      "CircuitBreakFailuresBeforeOpen": 5,
      "CircuitBreakOpenDuration": "00:00:30",
      "ShutdownGracePeriod": "00:00:25"
    }
  }
}
